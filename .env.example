ENVIRONMENT=dev
LOG_LEVEL=INFO

BOT_TOKEN=TOKEN_EXAMPLE

VOICES_DIR=storage/voices

WHISPER_CPP_DIR=/path/to/your/whisper.cpp
WHISPER_MODEL=ggml-base.bin

WHISPER_PORT=8080
WHISPER_HOST=host.docker.internal

HOST_OBSIDIAN_DIR=/path/to/your/obsidian/folder
OBSIDIAN_DIR=/app/storage/obsidian

OLLAMA_API_BASE=http://host.docker.internal:11434/api
LLM_MODEL=your/llm-9b
LLM_NUM_CTX=4096
EMBEDDING_MODEL=your-embedding:0.6b
OLLAMA_KEEP_ALIVE=5m

REDIS_URL=redis://redis:6379
FLUSH_TIMEOUT_MINUTES=60
IDEMPOTENCY_TTL_SECONDS=86400

RABBITMQ_USER=guest
RABBITMQ_PASS=guest

POSTGRES_USER=voicevault
POSTGRES_PASSWORD=voicevault
POSTGRES_DB=voicevault
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=obsidian_notes
QDRANT_VECTOR_SIZE=1536
